          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "[parameters('vmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "customData": "[base64(replace(replace(replace(replace(replace(replace(replace(variables('$fxv#0'), '__REPO_URL__', parameters('repoUrl')), '__REPO_BRANCH__', parameters('repoBranch')), '__CLIENT_URL__', parameters('clientUrl')), '__MONGODB_URI__', parameters('mongodbUri')), '__JWT_ACCESS_SECRET__', parameters('jwtAccessSecret')), '__JWT_REFRESH_SECRET__', parameters('jwtRefreshSecret')), '__GEMINI_API_KEY__', parameters('geminiApiKey')))]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
