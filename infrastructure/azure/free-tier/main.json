  "variables": {
    "$fxv#0": "#cloud-config\r\npackage_update: true\r\npackages:\r\n  - git\r\n  - ca-certificates\r\n  - curl\r\n  - gnupg\r\nruncmd:\r\n  - curl -fsSL https://get.docker.com | sh\r\n  - apt-get update\r\n  - apt-get install -y docker-compose-plugin\r\n  - usermod -aG docker azureuser\r\n  - systemctl enable docker\r\n  - |\r\n      mkdir -p /opt/talentmatch\r\n      git clone --branch __REPO_BRANCH__ __REPO_URL__ /opt/talentmatch\r\n      cat > /opt/talentmatch/.env <<EOF\r\n      MONGODB_URI=__MONGODB_URI__\r\n      CLIENT_URL=__CLIENT_URL__\r\n      JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__\r\n      JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__\r\n      GEMINI_API_KEY=__GEMINI_API_KEY__\r\n      EOF\r\n      cd /opt/talentmatch\r\n      bash infrastructure/azure/vm/deploy-on-vm.sh\r\n",
    "vnetName": "[format('{0}-vnet', parameters('vmName'))]",
    "subnetName": "app-subnet",
    "nsgName": "[format('{0}-nsg', parameters('vmName'))]",
    "publicIpName": "[format('{0}-ip', parameters('vmName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        }
      }
    },
